{
  "name": "botw-savediter",
  "version": "2.2.0",
  "description": "塞尔达传说：旷野之息 游戏存档修改器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Botw-Save-Editor --platform=win32 --arch=x64 --out=dist --overwrite",
    "make": "npm run package",
    "rebuild": "node_modules/.bin/electron-rebuild -f -w electron",
    "package-mac": "node_modules/.bin/electron-packager ./ --platform=darwin --arch=arm64 --out=./dist --ignore=node_modules --ignore=build-ol.sh  --ignore=README.md --ignore=zelda-botw/cover.png --ignore=zelda-botw/thumb.jpg",
    "package-mac-arm64": "node_modules/.bin/electron-packager ./ --platform=darwin --arch=arm64 --out=./dist --ignore=node_modules --ignore=build-ol.sh  --ignore=README.md --ignore=zelda-botw/cover.png --ignore=zelda-botw/thumb.jpg",
    "package-win": "electron-packager . Botw-Save-Editor --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/dist$"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xunzi229/Botw-Savediter.git#main"
  },
  "keywords": [
    "save",
    "editer",
    "botw"
  ],
  "author": "Rainforest; maintained by Xunzi229",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Xunzi229/Botw-Savediter/issues"
  },
  "homepage": "https://github.com/Xunzi229/Botw-Savediter#readme",
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "electron": "^43.2.0"
  }
}
